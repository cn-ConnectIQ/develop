generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  ORGANIZER
  EXPO_ORGANIZER
  EXHIBITOR
}

enum EventType {
  CONFERENCE
  EXPO
}

/// 活动类型（决定管理端菜单与能力）
enum ActivityType {
  CONFERENCE // 会议/论坛/沙龙
  EXPO // 展会（含展位/展商管理）
  EXHIBITION // 参展（展商运营：互动/抽奖/线索）
}

/// 活动数据来源
enum DataSource {
  NATIVE // 玖莅 原生创建
  BAGEVENT // 百格导入
  MARKETUP // MarketUP 导入
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  ARCHIVED
}

enum ParticipantRole {
  ATTENDEE
  SPEAKER
}

/// 系统角色（权限边界，互斥；与 honor tags 分离）
///
/// AI 匹配池规则（维护者必读）：
/// - system_role=EXHIBITOR 的所有人（主账号 is_booth_owner 与普通团队成员）
///   均正常进入 AI 匹配池——他们是访客最想连接的人，不能排除。
/// - 仅 system_role=ORGANIZER_STAFF 排除出 AI 匹配池（签到台/引导员，不是来做生意的）。
enum SystemRole {
  PARTICIPANT      // 普通参会者（默认）
  ORGANIZER        // 主办方后台工作人员
  EXHIBITOR        // 展商代表（主账号或展位团队成员，均进 AI 匹配池）
  ORGANIZER_STAFF  // 主办方现场工作人员（不进 AI 匹配池；原 STAFF）
}

