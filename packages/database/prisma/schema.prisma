  RANDOM
  QUIZ_BASED
  CHECKIN_BASED
  ACTIVITY_BASED
}

/// 抽奖玩法分类（与旧 LotteryType 并存，新数据优先读此字段）
enum LotteryCategory {
  POOL_DRAW // 类型① 奖池大抽奖（多等级，PC 端仪式化开奖）
  AUTO_PROBABILITY // 类型② 行为触发概率抽奖（转盘/九宫格等，即时出奖）
  INSTANT_CLAIM // 类型③ 直接领取（原 fill_get_gift，必得）
}

/// 一码通扫码动作类型
enum ScanActionType {
  CHECKIN // 活动签到
  STAMP // 集章打卡
  LOTTERY_VERIFY // 抽奖奖品核销
  GIFT_VERIFY // 礼品核销（必得类）
}

enum ScanResult {
  SUCCESS
  DUPLICATE
  INVALID
  NO_PERMISSION
}

/// 类型② 前端动画形态
enum AnimationType {
  WHEEL // 转盘
  GRID // 九宫格
  SLOT // 老虎机
  SPOTLIGHT // 名单扫光
  PACHINKO // 弹球
  GIFT_RAIN // 红包雨
}

/// 类型① POOL_DRAW 大屏投影动效（与 animation_type 分离，避免选项混用）
enum BigScreenAnimationType {
  ROLLING_MACHINE // 摇号机
  SPOTLIGHT_SCROLL // 滚动名单
  REEL_OF_HONOR // 荣耀转轮
  STARLIGHT_ORBIT // 星轨流转
  PRECISION_ROLLER // 精工数轮
  SCROLL_UNVEILING // 卷轴揭榜
}

/// 类型② 触发抽奖的用户动作
enum TriggerAction {
  FILL_FORM // 填表单
  SURVEY // 填问卷
  SCAN_ONLY // 仅扫码即触发（无需额外动作）
}

/// 抽奖归属：主办方全场 / 展商展位
