  fromUser   User   @relation("ExchangeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String @map("to_user_id")
  toUser     User   @relation("ExchangeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  eventId String? @map("event_id")
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  boothId String? @map("booth_id")

  status      ExchangeStatus @default(PENDING)
  message     String?
  fromAiMatch Boolean        @default(false) @map("from_ai_match")

  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")
  expiresAt   DateTime? @map("expires_at")

  @@unique([fromUserId, toUserId, eventId])
  @@index([toUserId, status])
  @@map("exchange_requests")
}

model PointsLedger {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  amount    Int
  reason    PointsReason
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_ledger")
}

model PointsRedemption {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  benefitName String   @map("benefit_name")
  pointsSpent Int      @map("points_spent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("points_redemptions")
}

model FeedItem {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  eventId       String?      @map("event_id")
  type          FeedItemType
  content       String
  aiScore       Int?         @map("ai_score")
  triggerReason String?      @map("trigger_reason")
  expiresAt     DateTime?    @map("expires_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("feed_items")
}

model AIReferralScan {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  scannedAt    DateTime @default(now()) @map("scanned_at")
  pairsFound   Int      @default(0) @map("pairs_found")
  feedsCreated Int      @default(0) @map("feeds_created")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("ai_referral_scans")
}

model BoothVisitSignal {
  id               String     @id @default(cuid())
  userId           String     @map("user_id")
  eventId          String     @map("event_id")
  signalType       SignalType @map("signal_type")
  entityId         String?    @map("entity_id")
  entityType       String?    @map("entity_type")
  payload          Json       @default("{}")
  inferredIntent   String?    @map("inferred_intent")
  intentConfidence Float?     @map("intent_confidence")
  occurredAt       DateTime   @default(now()) @map("occurred_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, eventId])
  @@index([eventId, signalType])
  @@index([occurredAt])
  @@map("booth_visit_signals")
}

model SnSession {
  id         String          @id @default(cuid())
  eventId    String          @map("event_id")
  status     SnSessionStatus @default(SCHEDULED)
  roundCount Int             @default(1) @map("round_count")
  startedAt  DateTime?       @map("started_at")
  endedAt    DateTime?       @map("ended_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  event Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pairs SnPair[]

  @@map("sn_sessions")
}

model SnPair {
  id                    String   @id @default(cuid())
  sessionId             String   @map("session_id")
  participantAId        String   @map("participant_a_id")
  participantBId        String   @map("participant_b_id")
  round                 Int      @default(1)
  ratingA               Int?     @map("rating_a")
  ratingB               Int?     @map("rating_b")
  connectionEstablished Boolean  @default(false) @map("connection_established")
  createdAt             DateTime @default(now()) @map("created_at")

  session      SnSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantA Participant @relation("SnPairParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB Participant @relation("SnPairParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)

  @@map("sn_pairs")
}

model InviteCampaign {
  id             String               @id @default(cuid())
  eventId        String               @map("event_id")
  createdBy      String?              @map("created_by")
  name           String
  channel        InviteChannel
  status         InviteCampaignStatus @default(DRAFT)
  templateId     String?              @map("template_id")
  subject        String?
  customMessage  String?              @map("custom_message")
  targetFilter   Json                 @default("{}") @map("target_filter")
  totalTarget    Int                  @default(0) @map("total_target")
  sentCount      Int                  @default(0) @map("sent_count")
  deliveredCount Int                  @default(0) @map("delivered_count")
  clickedCount   Int                  @default(0) @map("clicked_count")
  activatedCount Int                  @default(0) @map("activated_count")
  failedCount    Int                  @default(0) @map("failed_count")
  scheduledAt    DateTime?            @map("scheduled_at")
  startedAt      DateTime?            @map("started_at")
  completedAt    DateTime?            @map("completed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User?          @relation("CampaignCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  records InviteRecord[]

  @@index([eventId, status])
  @@map("invite_campaigns")
}

model InviteRecord {
  id              String             @id @default(cuid())
  campaignId      String             @map("campaign_id")
  participantId   String             @map("participant_id")
  userId          String?            @map("user_id")
  channel         InviteChannel
  destination     String
  activationToken String             @unique @default(cuid()) @map("activation_token")
  tokenExpiresAt  DateTime           @map("token_expires_at")
  status          InviteRecordStatus @default(PENDING)
  sentAt          DateTime?          @map("sent_at")
  deliveredAt     DateTime?          @map("delivered_at")
  clickedAt       DateTime?          @map("clicked_at")
  activatedAt     DateTime?          @map("activated_at")
  vendorMessageId String?            @map("vendor_message_id")
  errorMessage    String?            @map("error_message")
  retryCount      Int                @default(0) @map("retry_count")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  campaign    InviteCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participant Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([campaignId, participantId])
  @@index([campaignId, status])
  @@index([activationToken])
  @@index([vendorMessageId])
  @@index([status, updatedAt])
  @@map("invite_records")
}

model StampRally {
  id            String           @id @default(cuid())
  eventId       String           @map("event_id")
  createdById   String           @map("created_by")
  ownerType     StampOwnerType   @default(ORGANIZER) @map("owner_type")
  boothId       String?          @map("booth_id")
  name          String
  description   String?
  coverImage    String?          @map("cover_image")
  prize         String
  prizeImageUrl String?          @map("prize_image_url")
  prizeDesc     String?          @map("prize_desc")
  requiredCount Int              @map("required_count")
  totalBooths   Int              @default(0) @map("total_booths")
  boothIds      String[]         @default([]) @map("booth_ids")
  startsAt      DateTime?        @map("starts_at")
  endsAt        DateTime?        @map("ends_at")
  status        StampRallyStatus @default(DRAFT)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator        User                @relation("StampRallyCreator", fields: [createdById], references: [id], onDelete: Cascade)
  booth          ExhibitorBooth?     @relation("ExhibitorStampRally", fields: [boothId], references: [id], onDelete: SetNull)
  records        StampRecord[]
  winners        StampRallyWinner[]
  stamps         Stamp[]
  userProgresses UserStampProgress[]

  @@index([eventId, status])
  @@index([boothId])
  @@map("stamp_rallies")
}

model Stamp {
  id             String               @id @default(cuid())
  rallyId        String               @map("rally_id")
  name           String
  pointType      StampPointType       @default(BOOTH) @map("point_type")
  boothId        String?              @map("booth_id")
  customName     String?              @map("custom_name")
  location       String?
  icon           String?
  weight         Int                  @default(1)
  scanCode       String               @unique @default(cuid()) @map("scan_code")
  nfcTagId       String?              @unique @map("nfc_tag_id")
  collectMethods StampCollectMethod[] @default([SCAN]) @map("collect_methods")
  sortOrder      Int                  @default(0) @map("sort_order")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  rally      StampRally      @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  booth      ExhibitorBooth? @relation(fields: [boothId], references: [id], onDelete: SetNull)
  userStamps UserStamp[]

  @@index([rallyId])
  @@index([boothId])
  @@index([rallyId, pointType])
  @@map("stamps")
}

model UserStamp {
  id            String             @id @default(cuid())
  userId        String             @map("user_id")
  stampId       String             @map("stamp_id")
  collectMethod StampCollectMethod @default(SCAN) @map("collect_method")
  collectedAt   DateTime           @default(now()) @map("collected_at")
  verifiedBy    String?            @map("verified_by")

  stamp Stamp @relation(fields: [stampId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stampId])
  @@index([userId])
  @@map("user_stamps")
}

model UserStampProgress {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  rallyId        String    @map("rally_id")
  collectedCount Int       @default(0) @map("collected_count")
  isCompleted    Boolean   @default(false) @map("is_completed")
  completedAt    DateTime? @map("completed_at")
  redeemed       Boolean   @default(false)
  redeemedAt     DateTime? @map("redeemed_at")
  redemptionCode String?   @unique @map("redemption_code")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  rally StampRally @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rallyId])
  @@index([rallyId])
  @@map("user_stamp_progresses")
}

model StampRecord {
  id        String   @id @default(cuid())
  rallyId   String   @map("rally_id")
  userId    String   @map("user_id")
  boothId   String   @map("booth_id")
  stampedAt DateTime @default(now()) @map("stamped_at")

  rally StampRally     @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  booth ExhibitorBooth @relation(fields: [boothId], references: [id], onDelete: Cascade)

  @@unique([rallyId, userId, boothId])
  @@index([rallyId, userId])
  @@map("stamp_records")
}

model StampRallyWinner {
  id          String   @id @default(cuid())
  rallyId     String   @map("rally_id")
  userId      String   @map("user_id")
  completedAt DateTime @default(now()) @map("completed_at")
  redeemed    Boolean  @default(false)

  rally StampRally @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rallyId, userId])
  @@map("stamp_rally_winners")
}

// ── 计费 / 额度（阶段一：数据模型）──

/// 可售套餐（办会包 / 短信包 / 邮件包 / 互动点包）
model BillingPlan {
  id          String          @id @default(cuid())
  code        String          @unique
  kind        BillingPlanKind
  name        String
  description String?

  /// 标价（分）
  priceCents Int    @default(0) @map("price_cents")
  currency   String @default("CNY")

  /// 购买后入账额度
  includesSms               Int @default(0) @map("includes_sms")
  includesEmail             Int @default(0) @map("includes_email")
  includesInteractionPoints Int @default(0) @map("includes_interaction_points")

  /// 按场套餐：人数上限（null = 不限）
  maxAttendees Int? @map("max_attendees")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  metadata  Json?

  orders BillingOrder[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kind, isActive])
  @@map("billing_plans")
}

/// 订单（阶段一可人工标 PAID；后续接支付回调）
model BillingOrder {
  id     String       @id @default(cuid())
  orgId  String       @map("org_id")
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  planId String?      @map("plan_id")
  plan   BillingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  /// 下单人（可为空：运营代开）
  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("BillingOrderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// 绑到某场活动（办会套餐时使用）
  eventId String? @map("event_id")
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  status         BillingOrderStatus    @default(PENDING)
  paymentChannel BillingPaymentChannel @default(MANUAL) @map("payment_channel")

  amountCents Int    @map("amount_cents")
  currency    String @default("CNY")
  title       String

  /// 第三方支付单号
  externalPaymentId String? @map("external_payment_id")
  paidAt            DateTime? @map("paid_at")
  metadata          Json?

  ledgers BillingLedger[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orgId, status])
  @@index([eventId])
  @@index([externalPaymentId])
  @@map("billing_orders")
}

/// 组织额度钱包（短信 / 邮件 / 互动点）
model OrgWallet {
  id    String       @id @default(cuid())
  orgId String       @unique @map("org_id")
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  smsBalance               Int @default(0) @map("sms_balance")
  emailBalance             Int @default(0) @map("email_balance")
  interactionPointsBalance Int @default(0) @map("interaction_points_balance")

  ledgers BillingLedger[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("org_wallets")
}

/// 额度流水账本
model BillingLedger {
  id     String       @id @default(cuid())
  orgId  String       @map("org_id")
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  walletId String?    @map("wallet_id")
  wallet   OrgWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  orderId String?       @map("order_id")
  order   BillingOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  eventId String? @map("event_id")
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  type     BillingLedgerType
  resource BillingLedgerResource

  /// 变动量：CREDIT 为正数，DEBIT/REFUND 冲减时用正数表示数量，由 type 决定加减
  amount       Int
  balanceAfter Int    @map("balance_after")
  remark       String?

  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("BillingLedgerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId, resource, createdAt])
  @@index([orderId])
  @@index([walletId])
  @@map("billing_ledgers")
}
