# ── 数据库 ──
# 应用运行时（Session Pooler，本地开发）
DATABASE_URL="postgresql://postgres.[ID]:[密码]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct Connection（Prisma CLI / IPv6 环境）
DATABASE_URL_DIRECT="postgresql://postgres:[密码]@db.[ID].supabase.co:5432/postgres?sslmode=require"
# Vercel / 生产环境必配（Transaction Pooler，6543）；代码在 VERCEL=1 时优先使用
DATABASE_URL_POOLER="postgresql://postgres.[ID]:[密码]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL="https://[ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon key]"
SUPABASE_SERVICE_ROLE_KEY="[service role key]"

# ── Auth ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="[node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"]"

# 公开站点 URL（二维码、邀请链接；生产 CloudBase： https://9li.co/uc）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 对外子路径（CloudBase 网关剥 /uc 前缀；本地留空，生产从 NEXT_PUBLIC_APP_URL 自动推导）
# NEXT_PUBLIC_BASE_PATH="/uc"
# 构建时 basePath（通常与 NEXT_PUBLIC_BASE_PATH 相同，也可从 NEXT_PUBLIC_APP_URL 推导）
# NEXT_BASE_PATH="/uc"

# ── AI / LLM（DeepSeek）──
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash"

# 迁移期兼容（未配置 DEEPSEEK_API_KEY 时回退）
# LLM_API_KEY=""

# 定时任务 / 内部 API 鉴权（CloudBase 云函数 Cron 调用 /api/cron/*）
CRON_SECRET=""

# Embedding（向量召回，比 chat 模型便宜；默认 dashscope text-embedding-v3）
# EMBEDDING_PROVIDER="dashscope"
# EMBEDDING_API_KEY=""   # 未填则复用 LLM_API_KEY
# EMBEDDING_MODEL=""     # dashscope: text-embedding-v3 | zhipu: embedding-2
# EMBEDDING_DIMENSIONS="1024"

# 旧变量（保留兼容，新代码请用 LLM_*）
ANTHROPIC_API_KEY="sk-ant-..."

# ── 短信（优先 Submail 赛邮；未配则回退阿里云）──
# SMS_PROVIDER=submail | aliyun | auto（默认 auto：有 Submail 用赛邮）
# SMS_PROVIDER="auto"
SUBMAIL_APP_ID=""
SUBMAIL_APP_KEY=""
# 签名名不要带【】；须与该 AppID 下已运营商报备成功的签名完全一致
SUBMAIL_SIGN_NAME="南京弟齐信息"
# 鉴权默认 normal（signature=appkey，与官方示例一致）
# SUBMAIL_SIGN_TYPE=normal
# 可选：赛邮模板项目 ID（XSend）。不填则用 SMS/Send 正文模式
# SUBMAIL_PROJECT_CODE=""          # 验证码模板，变量 code
# SUBMAIL_PROJECT_INVITE=""        # 邀请模板，变量 name/event
# SUBMAIL_ENDPOINT="https://api-v4.mysubmail.com"
# Submail SUBHOOK：https://9li.co/uc/api/webhooks/submail-sms?token=...
# SUBMAIL_WEBHOOK_SECRET=""
# 本地强制走真发（默认 development 只打日志）
# FORCE_REAL_SMS="1"

# ── 短信回退：阿里云 Dysmsapi（Submail 未配时使用）──
# ALIYUN_ACCESS_KEY_ID="..."
# ALIYUN_ACCESS_KEY_SECRET="..."
# ALIYUN_SMS_SIGN_NAME="玖莅"
# ALIYUN_SMS_TEMPLATE_CODE="SMS_..."
# ALIYUN_SMS_INVITE_TEMPLATE_CODE="SMS_..."
# ALIYUN_SMS_REPORT_SECRET=""

# ── 邮件（Mailgun）──
# 未配置 MAILGUN_API_KEY 时仅打日志，不实际发信
# Private API key（Mailgun Dashboard → Sending → Domain settings → API Keys）
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="email.9li.co"
MAILGUN_FROM="玖莅 <noreply@email.9li.co>"
# us | eu
MAILGUN_REGION="us"
# 本地联调: node apps/web/scripts/send-test-email.mjs you@example.com
# Mailgun Webhook 签名密钥（Sending → Webhooks → HTTP webhook signing key）
# 回调 URL: https://9li.co/uc/api/webhooks/mailgun
# MAILGUN_WEBHOOK_SIGNING_KEY=""
# 阿里云短信送达报告回调鉴权（可与 CRON_SECRET 相同）
# 回调 URL: https://9li.co/uc/api/webhooks/aliyun-sms
# ALIYUN_SMS_REPORT_SECRET=""

# ── 微信小程序 ──
WX_MINI_APPID=""
WX_MINI_SECRET=""
# 兼容旧变量名（可选）
# WECHAT_MINI_APP_ID=""
# WECHAT_MINI_APP_SECRET=""
# developer | trial | formal
WX_MINI_PROGRAM_STATE="formal"

# ── 微信服务号（与小程序同主体，备案完成后配置）──
WX_MP_APPID=""
WX_MP_SECRET=""
WX_MP_TOKEN=""
# 消息加解密（可选；明文模式可不填）
# WX_MP_ENCODING_AES_KEY=""

# 订阅消息模板 ID（小程序后台申请）
WX_TMPL_EXCHANGE_REQUEST=""
WX_TMPL_EXCHANGE_RESULT=""
WX_TMPL_MEETING_INVITE=""
WX_TMPL_EXHIBITOR_INVITE=""
WX_TMPL_LOTTERY_RESULT=""

# 内部 API 鉴权（/api/wechat/send-subscribe-message），可与 CRON_SECRET 共用
WECHAT_INTERNAL_SECRET=""

# ── 支付宝（电脑网站支付 alipay.trade.page.pay）──
# 开放平台：https://open.alipay.com → 应用详情 → 开发设置
# 私钥请用 RSA2（SHA256withRSA）；多行密钥可写成一行并用 \n 表示换行
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
# 「支付宝公钥」（不是应用公钥）
ALIPAY_PUBLIC_KEY=""
# 正式：https://openapi.alipay.com/gateway.do
# 沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
# PKCS1（默认，工具生成常带 BEGIN RSA PRIVATE KEY）| PKCS8（BEGIN PRIVATE KEY）
# ALIPAY_KEY_TYPE="PKCS1"
# 可不填：默认由 NEXT_PUBLIC_APP_URL 推导
# 生产示例：https://9li.co/uc/api/billing/alipay/notify
# ALIPAY_NOTIFY_URL=""
# ALIPAY_RETURN_URL=""

# ── 微信支付（占位，待接入）──
# WECHAT_PAY_MCH_ID=""
# WECHAT_PAY_APP_ID=""          # 或复用 WX_MINI_APPID / WX_MP_APPID
# WECHAT_PAY_API_V3_KEY=""
# WECHAT_PAY_SERIAL_NO=""
# WECHAT_PAY_PRIVATE_KEY=""
# WECHAT_PAY_NOTIFY_URL=""

# ── 七牛云对象存储 + CDN（生产上传必配）──
# 控制台：https://portal.qiniu.com → 密钥管理 / 对象存储
# CloudBase：云托管 connectiq-web → 环境变量（勿写入 Git）
# 配齐后 /api/upload、语音备注、互动/集章二维码均上传到七牛，访问走 CDN
# 验证：GET /api/health → qiniu.configured === true
# 注意：QINIU_CDN_DOMAIN 必须 DNS 可解析，否则前端仍破图
QINIU_ACCESS_KEY=""
QINIU_SECRET_KEY=""
QINIU_BUCKET=""
# 绑定的 CDN 域名（可带或不带 https://）
QINIU_CDN_DOMAIN="cdn.9li.cn"
# 可选：公开端同源（前端展示用）；不填则以 QINIU_CDN_DOMAIN 为准
# NEXT_PUBLIC_CDN_URL="https://cdn.9li.cn"
# 可选机房：z0 华东 / z1 华北 / z2 华南 / na0 / as0；不填则自动探测
# QINIU_REGION="z0"
